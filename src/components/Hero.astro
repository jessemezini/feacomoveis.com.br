---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import hero1 from "../assets/images/hero1.png";
import hero2 from "../assets/images/hero2.png";
---

<section
  id="hero"
  class="grid grid-cols-1 lg:grid-cols-2 gap-5 py-10 container mx-auto relative z-10"
>
  <div class="flex flex-col text-center lg:text-left lg:pt-20">
    <h1 class="text-4xl font-bold mb-5">
      Móveis Planejados em <span class="text-[#888888]">Aço e MDF</span> Direto da
      Fábrica
    </h1>
    <h2 class="text-base mb-5 text-gray-500">
      Descubra armários e estantes com qualidade excepcional, fabricados por
      profissionais qualificados. Perfeitos para organizar e valorizar seus
      espaços.
    </h2>
    <a
      href="https://wa.me/5519988287751"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-accent rounded-full mx-auto lg:ml-0"
      >Solicite seu orçamento
      <Icon name="bxl--whatsapp" size={26} /></a
    >
  </div>

  <div class="hidden md:grid grid-cols-2 gap-x-5 w-full">
    <div class="relative max-w-96 lg:max-w-80 flex items-center justify-center">
      <div
        class="bg-secondary rounded-3xl w-64 lg:w-52 xl:w-64 h-[400px] lg:h-[520px]"
      >
      </div>
      <Image
        src={hero1}
        width="320"
        class="absolute max-w-72 lg:max-w-64 xl:max-w-72"
        alt="Armário de Ferramenta baixo"
      />
    </div>

    <div class="relative max-w-96 lg:max-w-80 flex items-center justify-center">
      <div
        class="bg-secondary rounded-3xl w-64 lg:w-52 xl:w-64 h-[400px] lg:h-[520px]"
      >
      </div>
      <Image
        src={hero2}
        width="280"
        class="absolute max-w-72 lg:max-w-64 xl:max-w-72"
        alt="Armário de Ferramenta baixo"
      />
    </div>
  </div>
</section>
