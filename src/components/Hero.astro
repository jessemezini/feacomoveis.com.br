---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import hero1 from "../assets/images/hero1.png";
import hero2 from "../assets/images/estantes.png";

import patternAccent from "../assets/images/pattern-accent.png";
import patternWhite from "../assets/images/pattern-white.png";
---

<section
  id="hero"
  class="grid grid-cols-1 lg:grid-cols-2 gap-6 py-10 container mx-auto relative z-10"
>
  <div class="flex flex-col text-center lg:text-left lg:pt-5">
    <h1 class="text-4xl sm:text-5xl leading-tight font-bold mb-5">
      Móveis em <span class="text-primary/70">Aço</span> Direto da Fábrica
    </h1>
    <p class="mb-5 text-gray-500">
      Transforme seus espaços com armários, estantes e arquivos feitos sob
      medida, com garantia de fábrica, montagem no local e modelos a pronta
      entrega. Entregamos em todo o estado de São Paulo, Minas Gerais e região.
    </p>
    <a
      id="wpplead-hero-section"
      href="https://wa.me/5519988287751"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-accent rounded-full mx-auto lg:ml-0 relative z-10"
      >Solicite seu orçamento
      <Icon name="bxl--whatsapp" size={26} /></a
    >
  </div>

  <div class="relative grid grid-cols-2 gap-x-5 w-full">
    <div class="w-56 sm:w-80 absolute left-1/4 -top-20">
      <Image src={patternAccent} alt="pattern enfeite" loading="eager" />
    </div>

    <div class="w-80 absolute -left-24 -bottom-14">
      <Image src={patternWhite} alt="pattern enfeite" loading="eager" />
    </div>

    <div class="relative max-w-96 lg:max-w-80 flex items-center justify-center">
      <div
        class="bg-secondary rounded-3xl w-64 lg:w-52 xl:w-64 h-[400px] lg:h-[520px]"
      >
      </div>
      <Image
        src={hero1}
        widths={[288, 576, 864]}
        sizes="(max-width: 288px) 100vw, 288px"
        class="absolute max-w-40 sm:max-w-64 xl:max-w-72"
        alt="Armário de Ferramenta baixo"
        loading="eager"
      />
    </div>

    <div class="relative max-w-96 lg:max-w-80 flex items-center justify-center">
      <div
        class="bg-secondary rounded-3xl w-64 lg:w-52 xl:w-64 h-[400px] lg:h-[520px]"
      >
      </div>
      <Image
        src={hero2}
        widths={[288, 576, 864]}
        sizes="(max-width: 288px) 100vw, 288px"
        class="absolute max-w-40 sm:max-w-56 xl:max-w-72"
        alt="Armário 3 gavetas"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero-stroke {
    -webkit-text-stroke-width: 2px;
    -webkit-text-stroke-color: black;
    /* color: transparent; */
  }
</style>
