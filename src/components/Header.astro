---
import {
  Astronav,
  MenuItems,
  MenuIcon,
  Dropdown,
  DropdownItems,
  StickyHeader,
} from "astro-navbar";

import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
import { categories } from "../data/categories";
---

<StickyHeader
  class="sticky top-0 border-b z-20 transition-all"
  scrollY={50}
  defaultClass="bg-base-100 border-transparent py-5"
  activeClass="bg-base-100 border-base-200 py-2 backdrop-blur-sm"
>
  <header id="header" class="lg:flex container mx-auto items-center">
    <Astronav closeOnClick>
      <div class="flex justify-between items-center w-full">
        <a href="/"
          ><img
            src="/logo.png"
            alt={SITE_TITLE}
            width="187.16px"
            height="64px"
          /></a
        >
        <div class="block lg:hidden">
          <MenuIcon class="w-7 h-7 text-base-content" />
        </div>
      </div>
      <MenuItems class="hidden lg:flex w-full justify-end">
        <ul class="flex flex-col lg:flex-row lg:gap-2">
          <li><HeaderLink href="/">Início</HeaderLink></li>
          <li>
            <Dropdown class="group">
              <button
                class="flex items-center btn btn-ghost text-base hover:bg-transparent hover:text-secondary rounded-none nav-link border-0"
              >
                <!-- <HeaderLink dropdownHref="#servicos"> TODO: highlight only when is page products -->
                <span class="mr-1">Produtos</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="3"
                  stroke="currentColor"
                  class="w-3 h-3 mt-0.5 group-open:rotate-180"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                </svg>
                <!-- </HeaderLink> -->
              </button>
              <DropdownItems class="relative">
                <div
                  class="absolute top-0 p-2 bg-base-100 shadow-lg rounded-md"
                >
                  <ul class="w-72 [&>li]:mb-1">
                    {
                      categories.map((category, index) => (
                        <li>
                          <HeaderLink
                            href={`/produtos?category=${category.name}`}
                            class="btn-sm w-full justify-start"
                          >
                            {category.name}
                          </HeaderLink>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </DropdownItems>
            </Dropdown>
          </li>
          <li><HeaderLink>Sobre Nós</HeaderLink></li>
          <li><HeaderLink href="#contato">Contato</HeaderLink></li>
        </ul>
      </MenuItems>
    </Astronav>
  </header>
</StickyHeader>

<style>
  .scroll-active {
    @apply text-secondary border-secondary border-b-2;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navLinks = document.querySelectorAll(".nav-link");

    const observerOptions = {
      threshold: 0.5,
    };

    const observerCallback: IntersectionObserverCallback = (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute("id");
        const navLink = document.querySelector(`#header a[href="#${id}"]`);

        if (!navLink) return;
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove("scroll-active"));
          navLink.classList.add("scroll-active");
        }
      });
    };

    const observer = new IntersectionObserver(
      observerCallback,
      observerOptions
    );
    sections.forEach((section) => observer.observe(section));
  });
</script>
