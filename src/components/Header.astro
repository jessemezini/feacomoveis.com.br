---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import {
  Astronav,
  MenuItems,
  MenuIcon,
  Dropdown,
  DropdownItems,
} from "astro-navbar";

import HeaderLink from "./HeaderLink.astro";
import IconsGroup from "./IconsGroup.astro";

import { SITE_TITLE } from "../consts";
import { categories } from "../data/categories";

import logo from "../assets/logo.png";
---

<header id="header" class="bg-secondary relative z-20 border-b border-base-200">
  <div class="container mx-auto">
    <div class="flex justify-between py-1">
      <div class="flex gap-x-4 items-center text-sm">
        <p class="hidden md:flex items-center gap-x-1">
          <Icon name="mdi-light--email" size={18} /> vendas@moveisdec.com.br
        </p>
        <div class="hidden md:block bg-secondary-content w-px h-1/2"></div>
        <p class="flex items-center gap-x-1">
          <Icon name="mdi--shop-hours-outline" size={18} /> Seg. a Sex. das 8 às
          17h
        </p>
      </div>
      <div>
        <IconsGroup />
      </div>
    </div>

    <div class="lg:flex items-center border-t border-base-200 py-2">
      <Astronav closeOnClick>
        <div class="flex justify-between items-center w-full">
          <a href="/"
            ><Image
              src={logo}
              alt={SITE_TITLE}
              width="100"
              densities={[1, 2, 3]}
              class="rounded-full"
              loading="eager"
            /></a
          >
          <div class="block lg:hidden">
            <MenuIcon class="w-7 h-7 text-base-content" />
          </div>
        </div>

        <MenuItems class="hidden lg:flex w-full justify-between">
          <ul class="flex flex-col lg:flex-row lg:gap-2">
            <li><HeaderLink href="/">Início</HeaderLink></li>
            <li>
              <Dropdown class="group">
                <button
                  class="flex items-center btn btn-ghost text-secondary-content hover:bg-secondary-content/10 hover:text-secondary-content"
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-label="Produtos"
                >
                  <span class="mr-1">Produtos</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="3"
                    stroke="currentColor"
                    class="w-3 h-3 mt-0.5 group-open:rotate-180"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                  </svg>
                  <!-- </HeaderLink> -->
                </button>
                <DropdownItems class="relative">
                  <div
                    class="absolute top-0 p-2 bg-secondary shadow-lg rounded-3xl"
                  >
                    <ul class="w-72 [&>li]:mb-1">
                      {
                        categories.map((category, index) => (
                          <li>
                            <HeaderLink
                              href={`/produtos?category=${category.name}`}
                              class="btn-sm w-full justify-start"
                            >
                              {category.name}
                            </HeaderLink>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                </DropdownItems>
              </Dropdown>
            </li>
            <li><HeaderLink href="#contato">Contato</HeaderLink></li>
          </ul>

          <a
            href="https://wa.me/5519988287751"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-accent rounded-full mx-auto lg:hidden"
            >Orçamento
            <Icon name="bxl--whatsapp" size={26} /></a
          >
        </MenuItems>

        <a
          href="https://wa.me/5519988287751"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-accent rounded-full mx-auto hidden lg:flex"
          >Orçamento
          <Icon name="bxl--whatsapp" size={26} /></a
        >
      </Astronav>
    </div>
  </div>
</header>
