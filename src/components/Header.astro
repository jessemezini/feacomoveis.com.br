---
import { Astronav, MenuItems, MenuIcon, Dropdown, DropdownItems, StickyHeader } from "astro-navbar";

import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
import IconsGroup from "./IconsGroup.astro";
---
<StickyHeader
  class="sticky top-0 border-b z-20 transition-all"
  scrollY={50}
  defaultClass="bg-base-100 border-base-300 py-5"
  activeClass="bg-base-100 border-base-300 py-4 backdrop-blur-sm">
<header class="lg:flex container mx-auto  items-center">
  <Astronav>
    <div class="flex justify-between w-full">
      <a href="/"
      ><img src="/logo.png" alt={SITE_TITLE} width="142.06px" height="48px" /></a
    >
      <div class="block lg:hidden">
        <MenuIcon class="w-4 h-4 text-gray-800" />
      </div>
    </div>
    <MenuItems class="hidden lg:flex w-full">
      <ul class="flex flex-col lg:flex-row lg:gap-2">
        <li><HeaderLink dropdownHref="/">Ínicio</HeaderLink></li>
        <li>
          <Dropdown class="group">
            <button class="flex items-center">
              <HeaderLink dropdownHref="/">
                <span class="mr-1">Serviços</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="3"
                  stroke="currentColor"
                  class="w-3 h-3 mt-0.5 group-open:rotate-180">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                </svg>
              </HeaderLink>
            </button>
            <DropdownItems class="relative">
              <div class="absolute top-0 p-2 bg-base-200 rounded-md">
                <ul class="w-52">
                  <li><HeaderLink href="/" class="btn-sm w-full justify-start">Design Gráfico</HeaderLink></li>
                  <li><HeaderLink href="/" class="btn-sm w-full justify-start">Portfolio</HeaderLink></li>
                  <li><HeaderLink href="/" class="btn-sm w-full justify-start">Casos de Sucesso</HeaderLink></li>
                </ul>
              </div>
            </DropdownItems>
          </Dropdown>
        </li>
        <li><HeaderLink href="#contato">Contato</HeaderLink></li>
      </ul>
    </MenuItems>
    <div class="flex gap-0.5">
      <IconsGroup isNavbar={true} />
    </div>
  </Astronav>
</header>
</StickyHeader>
