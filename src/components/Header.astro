---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import IconsGroup from "./IconsGroup.astro";
import CategoriesMenu from "./CategoriesMenu";

import { SITE_TITLE } from "../consts";

import logo from "../assets/logo.png";
---

<header id="header" class="bg-secondary relative z-20 border-b border-base-200">
  <div class="container mx-auto">
    <div class="flex justify-between py-1">
      <div class="flex gap-x-4 items-center text-sm">
        <p class="hidden md:flex items-center gap-x-1">
          <Icon name="mdi-light--email" size={18} /> vendas@moveisdec.com.br
        </p>
        <div class="hidden md:block bg-secondary-content w-px h-1/2"></div>
        <p class="flex items-center gap-x-1">
          <Icon name="mdi--shop-hours-outline" size={18} /> Seg. a Sex. das 8 às
          17h
        </p>
      </div>
      <div>
        <IconsGroup />
      </div>
    </div>

    <div class="navbar">
      <div class="navbar-start">
        <div class="dropdown">
          <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h8m-8 6h16"></path>
            </svg>
          </div>
          <ul
            tabindex="0"
            class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow"
          >
            <li>
              <a href="/" class="btn btn-secondary shadow-none rounded-3xl"
                >Início</a
              >
            </li>
            <CategoriesMenu client:load name="Produtos" />
            <li>
              <a
                href="#contato"
                class="btn btn-secondary shadow-none rounded-3xl">Contato</a
              >
            </li>
          </ul>
        </div>
        <a href="/"
          ><Image
            src={logo}
            alt={SITE_TITLE}
            width="100"
            densities={[1, 2, 3]}
            class="rounded-full"
            loading="eager"
          /></a
        >
      </div>

      <!-- DESKTOP -->
      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1">
          <li>
            <a href="/" class="btn btn-secondary shadow-none rounded-3xl"
              >Início</a
            >
          </li>
          <CategoriesMenu client:load name="Produtos" />
          <li>
            <a href="#contato" class="btn btn-secondary shadow-none rounded-3xl"
              >Contato</a
            >
          </li>
        </ul>
      </div>
      <div class="navbar-end">
        <a
          href="https://wa.me/5519988287751"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-accent rounded-full"
          >Orçamento
          <Icon name="bxl--whatsapp" size={26} /></a
        >
      </div>
    </div>
  </div>
</header>
