---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import IconsGroup from "./IconsGroup.astro";

import patternAccent from "../assets/images/pattern-accent.png";
import { SITE_TITLE } from "../consts";

import logo from "../assets/logo.png";

const today = new Date();
---

<footer id="contato" class="bg-secondary pt-10 pb-5">
  <div class="container mx-auto">
    <div
      class="flex flex-col md:flex-row items-center justify-around gap-5 pb-10 mb-10 border-b border-secondary-content/15"
    >
      <Image
        src={logo}
        alt={SITE_TITLE}
        width="100"
        densities={[1, 2, 3]}
        class="rounded-full"
      />

      <div class="prose max-w-4xl text-center md:text-left">
        <p>
          <span class="font-bold"
            >A DEC Móveis é uma empresa com 8 anos de experiência na fabricação
            de móveis em aço e MDF.</span
          > Atuamos em todo estado de São Paulo e Minas Gerais, oferecendo móveis
          de qualidade, direto da fábrica, com garantia e montagem no local. Trabalhamos
          com armários, estantes, arquivos, racks para celulares e móveis sob medida,
          sempre prezando pela durabilidade, resistência e ótimo acabamento.
        </p>
      </div>
    </div>
  </div>

  <div
    class="relative container mx-auto pb-10 flex flex-col md:flex-row gap-10 justify-between md:items-center"
  >
    <div
      class="w-80 absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
    >
      <Image src={patternAccent} alt="pattern enfeite" />
    </div>
    <div
      class="relative prose max-w-none prose-headings:text-secondary-content prose-p:text-secondary-content prose-p:text-sm"
    >
      <h3 class="mb-10">Entre em contato conosco!</h3>
      <h4>Endereço:</h4>
      <p class="mb-2">
        Rua Sebastião Nicolau Pires, nº 108 - Bairro Parque Catharina B. Ometto
      </p>
      <p class="m-0">CEP: 13.495-220 - Iracemápolis/SP</p>

      <a
        href="https://maps.app.goo.gl/4qNBJxpTe4pLmfzR7"
        class="btn btn-outline rounded-3xl mt-5"
        target="_blank"
        rel="noopener noreferrer"
        >Ver no mapa <Icon name="uiw--map" size={18} /></a
      >

      <h4>Contato:</h4>
      <p class="flex gap-x-1 items-center mb-2">
        <Icon name="bxl--whatsapp" size={18} /> 19 98828.7751
      </p>
      <p class="flex gap-x-1 items-center mt-0">
        <Icon name="mdi-light--email" size={18} /> vendas@moveisdec.com.br
      </p>

      <IconsGroup />

      <h4>Horário de funcionamento:</h4>
      <p class="flex gap-x-1 items-center">
        <Icon name="mdi--shop-hours-outline" size={18} /> De Segunda a Sexta das
        8 às 17h
      </p>

      <h4>Atendimento:</h4>
      <p class="flex gap-x-1 items-center max-w-xl">
        Atendemos: Iracemápolis, Limeira, Piracicaba, Campinas, Rio Claro,
        Americana, Santa Bárbara d’Oeste, todo o estado de São Paulo e Minas
        Gerais.
      </p>
    </div>

    <div class="flex flex-col w-full md:w-auto gap-3 prose">
      <h4>Navegação:</h4>
      <a href="/sobre-nos">Sobre Nós</a>
      <a href="/produtos?category=Armários%20de%20Ferramentas" class="link"
        >Armários de Ferramentas</a
      >
      <a
        href="/produtos?category=Arm%C3%A1rios%20e%20Colm%C3%A9ias"
        class="link">Armários e Colméias</a
      >
      <a href="/produtos?category=Arquivos" class="link">Arquivos</a>
      <a href="/produtos?category=Estantes" class="link">Estantes</a>
      <a href="/produtos?category=Mesas%20e%20Aparadores" class="link">Mesas</a>
      <a
        href="/produtos?category=Armários%20de%20Ferramentas"
        class="link flex items-center font-bold"
        >Todas Categorias de Produtos <Icon
          name="majesticons--chevron-right"
        /></a
      >
      <a href="/contato">Contato</a>
    </div>
  </div>

  <div class="container mx-auto">
    <div
      class="border-t border-secondary-content/15 pt-10 pb-5 flex flex-col md:flex-row justify-between items-center gap-5"
    >
      <small>
        &copy; {today.getFullYear()} DEC Móveis. Todos direitos reservados.
      </small>
      <div class="flex items-center gap-1">
        <p class="text-xs">Desenvolvimento:</p>

        <a
          href="https://mzndigital.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-secondary-content underline"
        >
          MZN Digital</a
        >
      </div>
    </div>
  </div>
</footer>
