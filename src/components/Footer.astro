---
import { Image } from "astro:assets";
import IconsGroup from "./IconsGroup.astro";

const today = new Date();
---

<section id="contato" class="bg-primary py-10 mt-20">
  <footer
    class="container mx-auto grid grid-cols-1 sm:grid-cols-3 gap-12 prose-p:font-thin prose-headings:text-primary-content prose-p:text-primary-content"
  >
    <div class="prose">
      <h3>Sobre Nós</h3>
      <p>
        DEC Móveis Planejados de Aço: Qualidade e Durabilidade para seu Espaço
      </p>
      <p>
        Armários, estantes, arquivos, vitrines e roupeiros em aço de alta
        resistência. Soluções versáteis e robustas para empresas e residências,
        com foco em organização e segurança.
      </p>
      <Image
        src="/logo-white.png"
        alt="logo DEC Móveis Planejados"
        width="240"
        height="82.07"
      />
    </div>

    <div class="prose">
      <h3>Atendimento</h3>
      <h4>Horários:</h4>
      <p>De Segunda a Sexta das 9 às 17h</p>

      <h4>Telefone / WhatsApp:</h4>
      <p>
        <span class="text-sm">19</span> 98828.7751
      </p>

      <h4>E-mail:</h4>
      <p>vendasdecplanejados@gmail.com</p>
    </div>

    <div class="prose">
      <h3>Endereço</h3>
      <p>
        Rua Antonio Casemiro, nº 765 - Bairro/Distrito Jd. Voluntário Pedro
        Freitas
        <br /> CEP: 13.495-248 - Iracemápolis/SP
      </p>

      <h4>Redes Sociais</h4>
      <IconsGroup />
    </div>
  </footer>
</section>
<div class="bg-secondary">
  <div
    class="container mx-auto py-2 flex justify-between items-center prose max-w-none text-secondary-content"
  >
    <small>
      &copy; {today.getFullYear()} DEC Móveis Planejados. Todos direitos reservados.
    </small>
    <a
      href="https://mzndigital.com"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-link text-secondary-content"
    >
      Desenvolvimento MZN Digital</a
    >
  </div>
</div>
