---
import { Icon } from "astro-icon/components";

import "@glidejs/glide/dist/css/glide.core.css";
import "@glidejs/glide/dist/css/glide.theme.css";
---

<div class="glide glideProduct">
  <div class="glide__track" data-glide-el="track">
    <ul class="glide__slides">
      <slot />
    </ul>
    <div class="glide__arrows" data-glide-el="controls">
      <button
        class="glide__arrow glide__arrow--left !bg-base-200 !text-primary !shadow-none !rounded-full !border-none !left-0 !py-3"
        data-glide-dir="<"
        ><Icon name="ic--round-navigate-before" size={26} /></button
      >
      <button
        class="glide__arrow glide__arrow--right !bg-base-200 !text-primary !shadow-none !rounded-full !border-none !right-0 !py-3"
        data-glide-dir=">"
        ><Icon name="ic--round-navigate-next" size={26} /></button
      >
    </div>
  </div>

  <script>
    import Glide from "@glidejs/glide";

    document.addEventListener("astro:page-load", () => {
      new Glide(".glideProduct", {
        rewind: false,
      }).mount();
    });
  </script>
</div>
