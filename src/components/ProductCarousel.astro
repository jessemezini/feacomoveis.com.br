---
import { Icon } from "astro-icon/components";

import "@glidejs/glide/dist/css/glide.core.css";
import "@glidejs/glide/dist/css/glide.theme.css";
---

<div class="glide glideProduct">
  <div class="glide__track" data-glide-el="track">
    <ul class="glide__slides">
      <slot />
    </ul>

    <div class="glide__arrows" data-glide-el="controls">
      <button
        class="glide__arrow glide__arrow--left !bg-secondary !border !border-secondary-content !text-primary !shadow-none !rounded-full !left-0 !py-3"
        data-glide-dir="<"
        ><Icon name="ic--round-navigate-before" size={26} /></button
      >
      <button
        class="glide__arrow glide__arrow--right !bg-secondary !border !border-secondary-content !text-primary !shadow-none !rounded-full !right-0 !py-3"
        data-glide-dir=">"
        ><Icon name="ic--round-navigate-next" size={26} /></button
      >
    </div>

    <div class="glide__bullets !bottom-0" data-glide-el="controls[nav]">
      <slot name="bullets" />
    </div>
  </div>

  <style is:global>
    .glide__bullet {
      @apply !bg-primary/30;
    }
    .glide__bullet {
      @apply !bg-primary/30;
    }
    .glide__bullet:hover {
      @apply !bg-primary/30;
      @apply !border-primary/30;
    }
    .glide__bullet--active {
      @apply !bg-primary;
      @apply !border-primary;
    }
  </style>

  <script>
    import Glide from "@glidejs/glide";

    document.addEventListener("astro:page-load", () => {
      new Glide(".glideProduct", {
        rewind: false,
      }).mount();
    });
  </script>
</div>
