---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  imagePath: string;
  name: string;
}

const { imagePath, name } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/categories/*.{jpeg,jpg,png,gif}"
);
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/images/categories/*.{jpeg,jpg,png,gif}"`
  );
---

<div class="glide__slide text-primary-content p-5">
  <a href={`/produtos?category=${name}`}>
    <div
      class="flex justify-center items-center bg-secondary shadow-md rounded-3xl mx-auto p-3 w-40 h-40"
    >
      <Image
        src={images[imagePath]()}
        alt={name}
        class="object-contain h-36 mx-auto"
      />
    </div>
    <p class="text-center my-5 text-sm">{name}</p>
  </a>
</div>
