---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  imagePath: string;
  altText: string;
  name: string;
}

const { imagePath, altText, name } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/categories/*.{jpeg,jpg,png,gif}"
);
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/images/categories/*.{jpeg,jpg,png,gif}"`
  );
---

<div class="swiper-slide text-primary-content p-5">
  <a href={`/produtos?category=${name}`}>
    <div
      class="flex justify-center items-center bg-base-100 shadow-md rounded-full w-32 h-32 mx-auto"
    >
      <Image
        src={images[imagePath]()}
        alt={altText}
        class="object-contain h-40 mx-auto"
      />
    </div>
    <p class="text-center my-5">{name}</p>
  </a>
</div>
