---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const allProducts = (await getCollection("products")).slice(0, 8);
---

<section class="container mx-auto mt-10 mb-20">
  <div
    class="flex flex-col sm:flex-row justify-between items-center prose max-w-none mb-10"
  >
    <div class="text-center sm:text-left flex flex-col-reverse">
      <h2 class="mt-0">Produtos em Destaque</h2>
      <p class="text-sm mb-2">Destaques</p>
    </div>
    <a href="/produtos" class="btn btn-outline rounded-3xl">
      Todos Produtos <Icon name="majesticons--chevron-right" />
    </a>
  </div>
  <ul
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5 justify-between"
  >
    {
      allProducts.map((product) => (
        <li>
          <a href={`/produtos/${product.slug}/`} class="flex flex-col group">
            <div class="bg-secondary p-4 h-72 rounded-3xl">
              <Image
                class="object-contain w-full h-full rounded-3xl group-hover:scale-105 transition-transform duration-300"
                src={product.data.heroImage}
                alt={product.data.title}
                width="350"
                height="350"
              />
            </div>
            <div class="h-28">
              <p class="font-semibold text-sm py-5 px-3 line-clamp-3">
                {product.data.title}
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>
