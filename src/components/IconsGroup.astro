---
import { Icon } from "astro-icon/components";

const { isNavbar } = Astro.props;
---

<a
  id="wpplead-social-icons"
  href="https://wa.me/5519988287751"
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "btn btn-sm btn-circle btn-ghost",
    { "max-[360px]:btn-sm": isNavbar },
  ]}
  aria-label="WhatsApp"
  ><Icon name="bxl--whatsapp" size={22} aria-hidden="true" /></a
>
<a
  href="https://www.facebook.com/dec.acoemdf/"
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "btn btn-sm btn-circle btn-ghost",
    { "max-[360px]:btn-sm": isNavbar },
  ]}
  aria-label="Facebook"
  ><Icon name="bxl--facebook-circle" size={22} aria-hidden="true" /></a
>
<a
  href="https://www.instagram.com/decacomdf/"
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "btn btn-sm btn-circle btn-ghost",
    { "max-[360px]:btn-sm": isNavbar },
  ]}
  aria-label="Instagram"
  ><Icon name="bxl--instagram" size={22} aria-hidden="true" /></a
>
