---
import { Icon } from "astro-icon/components";

const { isNavbar } = Astro.props;
---

<a
  class:list={[
    "btn btn-circle btn-primary hover:bg-base-200",
    { "max-[360px]:btn-sm": isNavbar },
  ]}><Icon name="bxl--whatsapp" size={26} /></a
>
<a
  class:list={[
    "btn btn-circle btn-primary hover:bg-base-200",
    { "max-[360px]:btn-sm": isNavbar },
  ]}><Icon name="bxl--facebook-circle" size={26} /></a
>
<a
  class:list={[
    "btn btn-circle btn-primary hover:bg-base-200",
    { "max-[360px]:btn-sm": isNavbar },
  ]}><Icon name="bxl--instagram" size={26} /></a
>
