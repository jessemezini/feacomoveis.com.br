---
import { Icon } from "astro-icon/components";

import "@glidejs/glide/dist/css/glide.core.css";
import "@glidejs/glide/dist/css/glide.theme.css";

import CategoriesGlideSlider from "./CategoriesGlideSlider.astro";
import { categories } from "../data/categories";
---

<div class="bg-primary sm:pb-20 py-10">
  <div
    class="container mx-auto prose max-w-none prose-headings:text-primary-content prose-p:text-primary-content prose-a:no-underline"
  >
    <div class="text-center sm:text-left flex flex-col-reverse">
      <h2 class="text-primary-content mt-0">Nossos Produtos</h2>
      <p class="text-sm mb-2">Por Categorias</p>
    </div>

    <div class="glide glideCarousel">
      <div class="glide__track" data-glide-el="track">
        <ul class="glide__slides">
          <!-- Slides -->
          {
            categories.map((category) => (
              <CategoriesGlideSlider
                imagePath={category.imageUrl}
                name={category.name}
              />
            ))
          }
        </ul>
      </div>

      <div class="glide__arrows hidden lg:block" data-glide-el="controls">
        <button
          class="glide__arrow glide__arrow--left !bg-primary !rounded-full !-top-14 !left-[89%] !py-3"
          data-glide-dir="<"
          ><Icon name="ic--round-navigate-before" size={22} /></button
        >
        <button
          class="glide__arrow glide__arrow--right !bg-primary !rounded-full !-top-14 !left-[95%] !right-auto !py-3"
          data-glide-dir=">"
          ><Icon name="ic--round-navigate-next" size={22} /></button
        >
      </div>

      <div
        class="glide__bullets !bottom-2 lg:!hidden"
        data-glide-el="controls[nav]"
      >
        {
          categories.map((_category, index) => (
            <button class="glide__bullet" data-glide-dir={`=${index}`} />
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import Glide, {
    Breakpoints,
    Controls,
    Swipe,
  } from "@glidejs/glide/dist/glide.modular.esm";

  document.addEventListener("astro:page-load", () => {
    new Glide(".glideCarousel", {
      type: "carousel",
      startAt: 0,
      perView: 5,
      breakpoints: {
        425: {
          perView: 1,
          gap: 10,
        },
        640: {
          perView: 2,
          gap: 20,
        },
        768: {
          perView: 3,
          gap: 20,
        },
        1024: {
          perView: 4,
          gap: 30,
        },
      },
    }).mount({ Breakpoints, Controls, Swipe });
  });
</script>
