---
import Layout from "../layouts/Layout.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main>
    <section
      id="hero"
      class="bg-secondary h-[1600px] flex items-center justify-center"
    >
      <p>Hero</p>
    </section>

    <section
      id="servicos"
      class="bg-indigo-100 h-[1600px] flex items-center justify-center"
    >
      <p>Serviços</p>
    </section>
    <section
      id="servicos1"
      class="bg-indigo-200 h-[1600px] flex items-center justify-center"
    >
      <p>Serviços</p>
    </section>
    <section
      id="servicos2"
      class="bg-indigo-300 h-[1600px] flex items-center justify-center"
    >
      <p>Serviços</p>
    </section>
    <section
      id="servicos3"
      class="bg-base-100 h-[1600px] flex items-center justify-center"
    >
      <p>Serviços</p>
    </section>

    <section
      id="contato"
      class="bg-accent h-[1600px] flex items-center justify-center"
    >
      <p class="text-accent-content">Contato</p>
    </section>

    <section
      id="teste"
      class="bg-primary h-[1600px] flex items-center justify-center"
    >
      <p class="text-primary-content">Teste</p>
    </section>
  </main>
</Layout>
