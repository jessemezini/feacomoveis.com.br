---
import Layout from '../layouts/Layout.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<div id="hero" class="bg-secondary h-[600px] flex items-center justify-center">
<p>Hero</p>
		</div>
		<div id="contato" class="bg-accent h-[600px] flex items-center justify-center">
<p class="text-accent-content">Contato</p>
		</div>
	</main>
</Layout>
